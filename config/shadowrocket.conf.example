# Group-Rule 小火箭分流配置示例
# 规则文件不包含代理策略；所有策略在这里定义。
# 中国直连采用严格覆盖域名规则；IP 仅由 GEOIP,CN,no-resolve 做保守兜底，避免海外域名因解析到中国 IP 而被误判为直连。

[Proxy Group]

🚀 策略选择 = select,PROXY,⚡ 优选,🧠 AI,policy-select-name=⚡ 优选
⚡ 优选 = fallback,interval=600,timeout=1,url=https://raw.githubusercontent.com/bulianglin/demo/main/10MB.bin,policy-regex-filter=^(?!.*(住宅|Grok)).*$
🧠 AI = fallback,interval=600,timeout=2,url=https://chat.openai.com/cdn-cgi/trace,policy-regex-filter=Grok专用|住宅

[Rule]

# 01. 广告 / 隐私 / 劫持：统一 REJECT
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/compiled/reject.list,REJECT

# 02. AI：高要求线路
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/atomic/ai/openai.list,🧠 AI,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/atomic/ai/anthropic.list,🧠 AI,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/atomic/ai/gemini.list,🧠 AI,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/atomic/ai/copilot.list,🧠 AI,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/atomic/ai/xai.list,🧠 AI,force-remote-dns

# 03. 海外专项服务：普通优选
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/compiled/streaming.list,⚡ 优选,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/compiled/social.list,⚡ 优选,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/compiled/developer.list,⚡ 优选,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/compiled/service.list,⚡ 优选,force-remote-dns
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/compiled/global.list,⚡ 优选,force-remote-dns

# 04. 中国大陆域名：严格覆盖档，规则本身不携带策略
RULE-SET,https://raw.githubusercontent.com/thunder0775/Group-Rule/main/rules/compiled/china.list,DIRECT

# 05. 中国大陆 IP：仅对显式 IP 目的地址做 GEOIP 判断，不解析域名
GEOIP,CN,DIRECT,no-resolve

# 06. 其余未知流量
FINAL,🚀 策略选择

[Host]

localhost = 127.0.0.1

[URL Rewrite]

^http://(www.)?g.cn https://www.google.com 302
^http://(www.)?google.cn https://www.google.com 302
